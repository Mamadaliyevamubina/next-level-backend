# Copy this file to .env and fill in your own values.
# Use the password you chose for the "postgres" user when installing PostgreSQL.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/next_level

# Any long random string. It signs login tokens, so keep it secret.
JWT_SECRET=change-me-to-a-long-random-string

PORT=4000

# Browser origins allowed to call the API, comma-separated,
# e.g. http://localhost:5173,https://practice.example.org
CORS_ORIGINS=http://localhost:5173

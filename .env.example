# Copy this file to .env and fill in your own values.
# Use the password you chose for the "postgres" user when installing PostgreSQL.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/next_level

# Any long random string. It signs login tokens, so keep it secret.
JWT_SECRET=change-me-to-a-long-random-string

PORT=4000

# Browser origins allowed to call the API, comma-separated,
# e.g. http://localhost:5173,https://practice.example.org
CORS_ORIGINS=http://localhost:5173

# AI marking ("Check my answer"). Get a key at https://platform.claude.com → API keys.
# Leave empty to turn AI marking off: students then only see "Mark it myself".
ANTHROPIC_API_KEY=

# Where the question images are, so the AI marker can see diagrams and tables. Set one of them:
#   FIGURES_URL  public address of the website that serves figures/ (on the server), e.g. https://practice.example.org
#   FIGURES_DIR  folder on this computer that contains figures/ (the Next-Level repo's public folder)
FIGURES_URL=
FIGURES_DIR=../9618-practice/public
